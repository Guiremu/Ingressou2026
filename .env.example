# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Assinatura HMAC dos QR Codes de ingresso (gerar uma string aleatória longa e nunca versionar)
TICKET_HMAC_SECRET=

# Mercado Pago — credenciais da aplicação da PLATAFORMA (Marketplace/OAuth)
MERCADOPAGO_PLATFORM_ACCESS_TOKEN=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=https://SEU_DOMINIO/api/mercadopago/oauth/callback
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do site (usada para montar notification_url do MP e links de ingresso)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Wallet (fase 2 do MVP — deixar em branco desabilita o botão "Salvar no Google Wallet")
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY=
